{% extends "layout.njk" %}
{% import "macros.njk" as macros %}

{% block main %}
{% set needsOptionHelpers = 'zeroableOption' in sharedSerializers %}
import { AccountMeta, isSigner, Pda, publicKey, PublicKey, Signer, isPda{% if needsOptionHelpers %}, isOption, isSome, none, Option, OptionOrNullable, some{% endif %} } from '@metaplex-foundation/umi';
{% if sharedSerializers.length > 0 %}
import { Serializer } from '@metaplex-foundation/umi/serializers';
{% endif %}

/**
 * Transforms the given object such that the given keys are optional.
 * @internal
 */
export type PickPartial<T, K extends keyof T> = Omit<T, K> & Partial<Pick<T, K>>;

/**
 * Asserts that the given value is not null or undefined.
 * @internal
 */
export function expectSome<T> (value: T | null | undefined): T {
  if (value == null) {
    throw new Error('Expected a value but received null or undefined.');
  }
  return value;
}

/**
 * Asserts that the given value is a PublicKey.
 * @internal
 */
export function expectPublicKey(
  value: PublicKey | Pda | Signer | null | undefined
): PublicKey {
  if (!value) {
    throw new Error('Expected a PublicKey.');
  }
  return publicKey(value, false);
}

/**
 * Asserts that the given value is a PDA.
 * @internal
 */
export function expectPda(
  value: PublicKey | Pda | Signer | null | undefined
): Pda {
  if (!value || !Array.isArray(value) || !isPda(value)) {
    throw new Error('Expected a PDA.');
  }
  return value;
}

/**
 * Defines an instruction account to resolve.
 * @internal
 */
export type ResolvedAccount<T = PublicKey | Pda | Signer | null> = { isWritable: boolean; value: T; }

/**
 * Defines a set of instruction account to resolve.
 * @internal
 */
export type ResolvedAccounts = Record<string, ResolvedAccount>;

/**
 * Defines a set of instruction account to resolve with their indices.
 * @internal
 */
export type ResolvedAccountsWithIndices = Record<string, ResolvedAccount & { index: number }>;

/**
 * Get account metas and signers from resolved accounts.
 * @internal
 */
export function getAccountMetasAndSigners(
  accounts: ResolvedAccount[],
  optionalAccountStrategy: 'omitted' | 'programId',
  programId: PublicKey,
): [AccountMeta[], Signer[]] {
  const keys: AccountMeta[] = [];
  const signers: Signer[] = [];

  accounts.forEach(account => {
    if (!account.value) {
      if (optionalAccountStrategy === 'omitted') return;
      keys.push({ pubkey: programId, isSigner: false, isWritable: false });
      return;
    }

    if (isSigner(account.value)) {
      signers.push(account.value);
    }
    keys.push({
      pubkey: publicKey(account.value, false),
      isSigner: isSigner(account.value),
      isWritable: account.isWritable,
    });
  });

  return [keys, signers];
};

{% if 'zeroableOption' in sharedSerializers %}
/**
 * Serializer for fixed-size optional values where `None` is represented
 * by a predefined "zero" byte pattern — with no prefix byte.
 * @internal
 */
export function zeroableOption<T, U extends T = T>(
  item: Serializer<T, U>,
  options: { zeroValue?: Uint8Array } = {}
): Serializer<OptionOrNullable<T>, Option<U>> {
  if (item.fixedSize === null) {
    throw new Error(
      'zeroableOption can only be used with fixed-size serializers.'
    );
  }
  const size = item.fixedSize;
  const zeroValue = options.zeroValue ?? new Uint8Array(size);
  if (zeroValue.length !== size) {
    throw new Error(
      'zeroableOption expects the zeroValue to have the same size as the item serializer.'
    );
  }
  return {
    description: `zeroableOption(${item.description})`,
    fixedSize: size,
    maxSize: size,
    serialize: (optionOrNullable: OptionOrNullable<T>) => {
      const option = isOption(optionOrNullable)
        ? optionOrNullable
        : optionOrNullable === null
          ? none<T>()
          : some(optionOrNullable);
      if (isSome(option)) {
        const bytes = item.serialize(option.value);
        if (bytes.length !== size) {
          throw new Error(
            `zeroableOption expected the item serializer to return ${size} bytes but got ${bytes.length} bytes.`
          );
        }
        return bytes;
      }
      return new Uint8Array(zeroValue);
    },
    deserialize: (bytes: Uint8Array, offset = 0) => {
      if (bytes.length - offset < size) {
        throw new Error(
          `zeroableOption expected ${size} bytes at offset ${offset}.`
        );
      }
      const isZero = zeroValue.every(
        (byte, index) => bytes[offset + index] === byte
      );
      if (isZero) return [none<U>(), offset + size];
      const [value] = item.deserialize(bytes, offset);
      return [some(value), offset + size];
    },
  };
}
{% endif %}
{% endblock %}
